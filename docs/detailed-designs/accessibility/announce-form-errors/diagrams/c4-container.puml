@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Containers — Label form controls and announce errors

Person(organiser, "Organiser", "Submits organiser forms")
Person(guest, "Guest", "Submits the RSVP form")
System_Boundary(invitely, "Invitely") {
  Container(admin, "Organiser web application", "<TO SUPPLY>", "Organiser forms under src/admin")
  Container(rsvp, "Guest RSVP web application", "<TO SUPPLY>", "RSVP form under src/rsvp")
  Container(shared, "Shared UI library", "<TO SUPPLY>", "Form field, error and announcement components under src/shared/forms")
}
System_Ext(assistive, "Assistive technology", "Reads names, errors and live regions")

Rel(organiser, admin, "Submits forms in", "HTTPS")
Rel(guest, rsvp, "Submits the RSVP form in", "HTTPS")
Rel(admin, shared, "Imports form fields and announcers from")
Rel(rsvp, shared, "Imports form fields and error summary from")
Rel(shared, assistive, "Exposes labels, errors and live messages to")
@enduml
