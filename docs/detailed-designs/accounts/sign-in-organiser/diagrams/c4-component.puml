@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Sign in as an organiser

Container_Boundary(admin, "Organiser web application") {
  Component(page, "SignInPage", "React 19 component", "Renders the sign-in form, its loading state and its errors; src/admin/pages/SignIn.tsx")
}
Container_Boundary(api, "API application") {
  Component(endpoint, "SignInEndpoint", "Express 5 route", "POST /api/auth/sign-in in src/api/auth.ts; sets the session cookie")
  Component(service, "SignInService", "TypeScript, merged into the route", "Runs one sign-in attempt in the sign-in handler; verifyPassword (scrypt) in src/domain/password.ts")
  Component(sessions, "SessionService", "TypeScript", "Store.createSession with the lifetimes in src/domain/session.ts")
}
ComponentDb(store, "AccountStore", "Store interface; PrismaStore on PostgreSQL 17", "organisers table; Store.findOrganiserByEmail in src/data/store.ts")

Rel(page, endpoint, "Sends credentials to", "JSON/HTTPS")
Rel(endpoint, service, "Calls")
Rel(service, store, "Loads and updates accounts in")
Rel(service, sessions, "Creates the session through")
@enduml
