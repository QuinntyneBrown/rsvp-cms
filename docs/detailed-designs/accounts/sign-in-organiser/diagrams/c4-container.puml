@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Containers — Sign in as an organiser

Person(organiser, "Organiser", "Signs in to manage their events")
System_Boundary(invitely, "Invitely") {
  Container(admin, "Organiser web application", "React 19, Vite", "Sign-in page under src/admin")
  Container(api, "API application", "Node.js 24, Express 5", "Sign-in endpoint and session cookie under src/api")
  ContainerDb(db, "Database", "PostgreSQL 17", "organisers and sessions tables; schema and migrations under src/data/prisma")
}

Rel(organiser, admin, "Signs in using", "HTTPS")
Rel(admin, api, "Posts credentials to", "JSON/HTTPS")
Rel(api, db, "Reads and writes accounts", "Prisma ORM 7, @prisma/adapter-pg")
@enduml
