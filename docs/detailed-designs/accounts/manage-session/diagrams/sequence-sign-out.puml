@startuml
title UML sequence behaviour — Sign out of Invitely
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Organiser" as actor
box "Frontend — Organiser app" #E0F2FE
  participant "OrganiserShell" as shell
end box
box "Backend — API application" #D1FADF
  participant "SignOutEndpoint" as endpoint
end box
box "Backend — Application and domain" #ECFDF3
  participant "SessionService" as sessions
end box
box "Backend — Data and infrastructure" #FFF4E5
  database "SessionStore" as db
end box
actor -> shell : Choose Sign out
shell -> endpoint : Sign-out request
endpoint -> sessions : End(sessionId, now)
sessions -> db : Mark session revoked
db --> sessions : Saved
sessions --> endpoint : Session ended
endpoint --> shell : Clear session cookie
shell --> actor : Show Sign in page
note over endpoint
  A later request with the old cookie is rejected
  with HTTP 401 by the session check.
end note
@enduml
