@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Manage organiser sessions

Container_Boundary(admin, "Organiser web application") {
  Component(shell, "OrganiserShell", "React 19 component", "Hosts the Sign out control and returns to Sign in when a session ends; App in src/admin/App.tsx")
}
Container_Boundary(api, "API application") {
  Component(guard, "SessionGuard", "Express 5 middleware", "requireAuth in src/api/auth.ts; checks the session cookie on each organiser request")
  Component(signOut, "SignOutEndpoint", "Express 5 route", "POST /api/auth/sign-out in src/api/auth.ts; ends the current session and clears the cookie")
  Component(signIn, "SignInService", "Express 5 route", "Creates a session at sign-in (Sign in as an organiser); POST /api/auth/sign-in")
  Component(sessions, "SessionService", "TypeScript", "Creates, checks, ends and revokes sessions; src/domain/session.ts and the session methods of Store")
}
ComponentDb(store, "SessionStore", "Store interface; PrismaStore on PostgreSQL 17", "sessions table; id is the 256-bit random cookie value")

Rel(shell, guard, "Sends requests with the session cookie to", "JSON/HTTPS")
Rel(shell, signOut, "Posts sign-out to", "JSON/HTTPS")
Rel(guard, sessions, "Checks the session through")
Rel(signOut, sessions, "Ends the session through")
Rel(signIn, sessions, "Creates the session through")
Rel(sessions, store, "Reads and writes sessions in")
@enduml
