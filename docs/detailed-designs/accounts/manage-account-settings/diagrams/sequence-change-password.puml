@startuml
title UML sequence behaviour — Change password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Organiser" as actor
box "Frontend — Organiser app" #E0F2FE
  participant "AccountSettingsPage" as page
end box
box "Backend — API application" #D1FADF
  participant "AccountSettingsEndpoint" as endpoint
end box
box "Backend — Application and domain" #ECFDF3
  participant "ChangePasswordService" as service
  participant "PasswordPolicy" as policy
  participant "SessionService" as sessions
end box
box "Backend — Data and infrastructure" #FFF4E5
  database "AccountStore" as db
end box
actor -> page : Submit current, new and confirmed passwords
alt New password and confirmation differ
  page --> actor : Field error, no request sent
else Values match
  page -> endpoint : Change password request
  endpoint -> service : Change(accountId, current, new, sessionId)
  service -> db : Load account and verify current password
  alt Current password is wrong
    service --> endpoint : CurrentPasswordWrong
    endpoint --> page : Error
    page --> actor : "Current password is not right"
  else Current password is correct
    service -> policy : Check new password (L2-060)
    alt New password equals current password
      service --> endpoint : SameAsCurrent
      endpoint --> page : Error
      page --> actor : "Choose a different password"
    else New password is 12 characters or more and differs
      service -> db : Store new password hash
      service -> sessions : End all other sessions of the account
      sessions --> service : Sessions ended
      service --> endpoint : Changed
      endpoint --> page : Success
      page --> actor : "Last changed just now"
    end
  end
end
@enduml
