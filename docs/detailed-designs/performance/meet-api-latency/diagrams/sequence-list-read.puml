@startuml
title UML sequence behaviour — Meet API response-time targets
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Organiser" as actor
box "Frontend — Organiser admin app" #E0F2FE
  participant "GuestListClient" as client
end box
box "Backend — API application" #D1FADF
  participant "GuestsController" as ctrl
end box
box "Backend — Application and domain" #ECFDF3
  participant "GuestListReadService" as svc
end box
box "Backend — Data and infrastructure" #FFF4E5
  database "Guest repository" as repo
end box
actor -> client : Open the Guests page
client -> ctrl : Request page of up to 50 guests
ctrl -> svc : Read page with validated PagedQuery
svc -> repo : Query by event identifier and sort key
repo --> svc : Matching rows
svc --> ctrl : PagedResult<Guest>
ctrl --> client : Response (L2-076 criterion 1)
client --> actor : Render the page
@enduml
