@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Containers — View and filter responses

Person(organiser, "Organiser", "Event owner")
System_Boundary(invitely, "Invitely") {
  Container(admin, "Organiser admin application", "React 19, Vite", "Responses page under src/admin")
  Container(api, "Organiser API application", "Node.js 24, Express 5", "Responses endpoint under src/api/responses")
  ContainerDb(db, "Invitely database", "PostgreSQL 17", "Replies (responses table), guests and events")
}
Rel(organiser, admin, "Uses", "HTTPS")
Rel(admin, api, "Requests replies and totals from", "JSON/HTTPS")
Rel(api, db, "Queries replies and totals from", "Prisma ORM 7, @prisma/adapter-pg")
@enduml
