@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Containers — Show the event overview

Person(organiser, "Organiser", "Signed-in user who owns the event")
System_Boundary(invitely, "Invitely") {
  Container(admin, "Organiser app", "<TO SUPPLY>", "Organiser UI in src/admin")
  Container(api, "API application", "<TO SUPPLY>", "HTTP endpoints in src/api")
  ContainerDb(db, "Invitely database", "<TO SUPPLY>", "Stores events, guests and replies")
}

Rel(organiser, admin, "Opens the overview using", "HTTPS")
Rel(admin, api, "Requests the overview from", "HTTPS, JSON")
Rel(api, db, "Reads counts and replies from", "<TO SUPPLY>")
@enduml
