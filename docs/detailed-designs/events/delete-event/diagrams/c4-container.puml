@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Containers — Delete an event

Person(organiser, "Organiser", "Signed-in user who owns the event")
System_Boundary(invitely, "Invitely") {
  Container(admin, "Organiser app", "<TO SUPPLY>", "Organiser UI in src/admin")
  Container(api, "API application", "<TO SUPPLY>", "HTTP endpoints in src/api")
  ContainerDb(db, "Invitely database", "<TO SUPPLY>", "Stores events and dependent records")
}

Rel(organiser, admin, "Confirms deletion using", "HTTPS")
Rel(admin, api, "Sends delete request to", "HTTPS")
Rel(api, db, "Deletes records in one transaction from", "<TO SUPPLY>")
@enduml
