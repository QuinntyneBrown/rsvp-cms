@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Containers — Regenerate invitation links

Person(organiser, "Organiser", "Signed-in user who owns the event")
System_Boundary(invitely, "Invitely") {
  Container(admin, "Organiser app", "<TO SUPPLY>", "Organiser UI in src/admin")
  Container(api, "API application", "<TO SUPPLY>", "HTTP endpoints in src/api")
  ContainerDb(db, "Invitely database", "<TO SUPPLY>", "Stores events and the invitation epoch")
}

Rel(organiser, admin, "Confirms regeneration using", "HTTPS")
Rel(admin, api, "Sends regeneration request to", "HTTPS")
Rel(api, db, "Advances the epoch in", "<TO SUPPLY>")
@enduml
