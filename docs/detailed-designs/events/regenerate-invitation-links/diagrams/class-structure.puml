title Class structure — Regenerate invitation links

class RegenerateInvitationLinksCommand {
  +UUID EventId
  +UUID RequestedBy
}

class InvitationEpoch {
  +int Value
  +Next(): InvitationEpoch
}

class Event {
  +UUID Id
  +InvitationEpoch Epoch
  +AdvanceEpoch(): void
}

class InvitationLinkService {
  +Regenerate(command: RegenerateInvitationLinksCommand): Result
}

interface IEventRepository {
  +AdvanceEpoch(eventId: UUID): InvitationEpoch
}

InvitationLinkService ..> RegenerateInvitationLinksCommand : handles
InvitationLinkService --> Event : changes
Event "1" *-- "1" InvitationEpoch : holds
InvitationLinkService --> IEventRepository : saves through
@enduml
