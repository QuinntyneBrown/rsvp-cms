@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Containers — List and find events

Person(organiser, "Organiser", "Signed-in user who owns events")
System_Boundary(invitely, "Invitely") {
  Container(admin, "Organiser app", "<TO SUPPLY>", "Organiser UI in src/admin")
  Container(api, "API application", "<TO SUPPLY>", "HTTP endpoints in src/api")
  ContainerDb(db, "Invitely database", "<TO SUPPLY>", "Stores events and replies")
}

Rel(organiser, admin, "Browses events using", "HTTPS")
Rel(admin, api, "Requests a page of events from", "HTTPS, JSON")
Rel(api, db, "Reads events from", "<TO SUPPLY>")
@enduml
