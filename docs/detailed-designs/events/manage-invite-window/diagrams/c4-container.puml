@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Containers — Manage the invite window and event status

Person(organiser, "Organiser", "Signed-in user who owns the event")
System_Boundary(invitely, "Invitely") {
  Container(admin, "Organiser app", "<TO SUPPLY>", "Organiser UI in src/admin")
  Container(api, "API application", "<TO SUPPLY>", "HTTP endpoints in src/api")
  ContainerDb(db, "Invitely database", "<TO SUPPLY>", "Stores events and their invite windows")
}

Rel(organiser, admin, "Edits the invite window using", "HTTPS")
Rel(admin, api, "Sends window changes to", "HTTPS, JSON")
Rel(api, db, "Reads and writes events in", "<TO SUPPLY>")
@enduml
