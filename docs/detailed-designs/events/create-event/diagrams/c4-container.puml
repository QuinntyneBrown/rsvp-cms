@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Containers — Create an event

Person(organiser, "Organiser", "Signed-in user who owns the event")
System_Boundary(invitely, "Invitely") {
  Container(admin, "Organiser app", "React 19, Vite", "Organiser UI in src/admin")
  Container(api, "API application", "Node.js 24, Express 5", "HTTP endpoints in src/api")
  ContainerDb(db, "Invitely database", "PostgreSQL 17", "Stores events in the events table")
}

Rel(organiser, admin, "Creates events using", "HTTPS")
Rel(admin, api, "Sends create-event requests to", "HTTPS, JSON")
Rel(api, db, "Writes events to", "Prisma ORM 7, @prisma/adapter-pg")
@enduml
