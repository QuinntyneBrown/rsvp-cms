@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Containers — Create an event

Person(organiser, "Organiser", "Signed-in user who owns the event")
System_Boundary(invitely, "Invitely") {
  Container(admin, "Organiser app", "<TO SUPPLY>", "Organiser UI in src/admin")
  Container(api, "API application", "<TO SUPPLY>", "HTTP endpoints in src/api")
  ContainerDb(db, "Invitely database", "<TO SUPPLY>", "Stores events")
}

Rel(organiser, admin, "Creates events using", "HTTPS")
Rel(admin, api, "Sends create-event requests to", "HTTPS, JSON")
Rel(api, db, "Writes events to", "<TO SUPPLY>")
@enduml
