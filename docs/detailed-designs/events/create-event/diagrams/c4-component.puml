@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Create an event

Container_Boundary(admin, "Organiser app") {
  Component(page, "NewEventPage", "React 19 component", "Renders the New event form; src/admin/pages/NewEvent.tsx")
  Component(client, "EventsClient", "TypeScript fetch helper", "Sends create requests; post in src/shared/ui/api.ts")
}
Container_Boundary(api, "API application") {
  Component(ctrl, "EventsController", "Express 5 router", "Exposes POST /api/events; eventRoutes in src/api/events/routes.ts")
  Component(service, "EventCreationService", "TypeScript module", "Checks a new event; validateNewEvent in src/domain/events.ts")
  Component(repo, "EventRepository", "Store interface; PrismaStore on PostgreSQL 17", "Persists Draft events; Store.createEvent in src/data/store.ts")
  ComponentDb(db, "Event store", "PostgreSQL 17", "events table, plus an empty pages row for each event")
}

Rel(page, client, "Submits form values to")
Rel(client, ctrl, "Sends POST /api/events to", "HTTPS, JSON")
Rel(ctrl, service, "Validates the request with")
Rel(ctrl, repo, "Saves the Draft event through")
Rel(repo, db, "Writes to", "Prisma ORM 7")
@enduml
