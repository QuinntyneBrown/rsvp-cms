@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Containers — Send reminders to guests who have not replied

Person(organiser, "Organiser", "Schedules reminders")
Person(guest, "Guest", "Replies to the invitation")
System_Boundary(invitely, "Invitely") {
  Container(admin, "Organiser app", "<TO SUPPLY>", "Organiser UI under src/admin")
  Container(rsvp, "Guest RSVP app", "<TO SUPPLY>", "Public RSVP page under src/rsvp")
  Container(api, "API application", "<TO SUPPLY>", "Endpoints under src/api and domain logic under src/domain")
  ContainerDb(db, "Application database", "<TO SUPPLY>", "Stores replies and scheduled reminders")
}

Rel(organiser, admin, "Uses", "HTTPS")
Rel(guest, rsvp, "Uses", "HTTPS")
Rel(admin, api, "Schedules reminders through", "JSON/HTTPS")
Rel(rsvp, api, "Sends replies through", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "<TO SUPPLY>")
@enduml
