@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Containers — Review scheduled and sent emails

Person(organiser, "Organiser", "Reviews scheduled emails")
System_Boundary(invitely, "Invitely") {
  Container(admin, "Organiser app", "React 19, Vite", "Organiser UI under src/admin")
  Container(api, "API application", "Node.js 24, Express 5", "Endpoints under src/api and message text under src/domain")
  ContainerDb(db, "Application database", "PostgreSQL 17", "Stores scheduled emails in the emails table")
}

Rel(organiser, admin, "Uses", "HTTPS")
Rel(admin, api, "Requests the list and previews from", "JSON/HTTPS")
Rel(api, db, "Reads", "Prisma ORM 7, @prisma/adapter-pg")
@enduml
