@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Containers — Add, edit and remove guests

Person(organiser, "Organiser", "Maintains the invitee list")
System_Boundary(cms, "RSVP CMS") {
  Container(admin, "Organiser app", "<TO SUPPLY>", "Guest dialogs under src/admin")
  Container(api, "Organiser API", "<TO SUPPLY>", "Guest command endpoints under src/api/guests")
  ContainerDb(db, "Application database", "<TO SUPPLY>", "Stores guests and replies under src/data")
}
System_Ext(queue, "Scheduled email queue", "Holds pending reminders")

Rel(organiser, admin, "Adds, edits and removes guests using", "HTTPS")
Rel(admin, api, "Sends guest commands to", "JSON/HTTPS")
Rel(api, db, "Reads and writes guests in", "<TO SUPPLY>")
Rel(api, queue, "Cancels pending reminders in", "<TO SUPPLY>")
@enduml
