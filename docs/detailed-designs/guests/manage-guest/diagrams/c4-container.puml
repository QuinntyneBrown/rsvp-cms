@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Containers — Add, edit and remove guests

Person(organiser, "Organiser", "Maintains the invitee list")
System_Boundary(cms, "RSVP CMS") {
  Container(admin, "Organiser app", "React 19, Vite", "Guest dialogs under src/admin")
  Container(api, "Organiser API", "Node.js 24, Express 5", "Guest command endpoints under src/api/guests")
  ContainerDb(db, "Application database", "PostgreSQL 17", "Stores guests, replies and the scheduled email queue (emails and deliveries tables)")
}

Rel(organiser, admin, "Adds, edits and removes guests using", "HTTPS")
Rel(admin, api, "Sends guest commands to", "JSON/HTTPS")
Rel(api, db, "Reads and writes guests in; removal cascades to replies and pending deliveries", "Prisma ORM 7, @prisma/adapter-pg")
@enduml
