@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Containers — Import guests from a CSV file

Person(organiser, "Organiser", "Imports the guest list")
System_Boundary(cms, "RSVP CMS") {
  Container(admin, "Organiser app", "<TO SUPPLY>", "Import wizard under src/admin")
  Container(api, "Organiser API", "<TO SUPPLY>", "Import and template endpoints under src/api/guests/import")
  ContainerDb(db, "Application database", "<TO SUPPLY>", "Stores import batches and guests under src/data")
}

Rel(organiser, admin, "Imports the guest list using", "HTTPS")
Rel(admin, api, "Uploads the file to and commits batches through", "multipart HTTPS")
Rel(api, db, "Reads and writes import batches and guests in", "<TO SUPPLY>")
@enduml
