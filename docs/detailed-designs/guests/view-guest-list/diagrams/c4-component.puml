@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — View, search and select guests

Container_Boundary(admin, "Organiser app") {
  Component(page, "GuestsPage", "React 19 component", "Hosts the guest table, search, filters and selection bar; GuestsTab in src/admin/pages/Guests.tsx")
  Component(search, "GuestSearchField", "React 19 hook", "Applies the search text 300 ms after the last keystroke; useDebounced in src/shared/ui/hooks.ts")
  Component(selection, "GuestSelectionStore", "React 19 state", "Keeps the selected guest identifiers across pages; a Set held by GuestsTab")
}
Container_Boundary(api, "Organiser API") {
  Component(ctrl, "GuestListController", "Express 5 route", "GET /api/events/:id/guests in src/api/guests/routes.ts")
  Component(query, "GuestQuery", "Domain type", "Holds the search text, reply filter and page number")
  Component(reader, "GuestListReader", "Domain interface", "Returns one page of guests for an event")
  ComponentDb(store, "GuestReadRepository", "Store interface; PrismaStore on PostgreSQL 17", "Implements GuestListReader; Store.listGuests")
}

Rel(page, search, "Uses")
Rel(page, selection, "Reads and writes selected guests in")
Rel(page, ctrl, "Requests guest pages from", "JSON/HTTPS")
Rel(ctrl, query, "Builds")
Rel(ctrl, reader, "Requests a page of guests from")
Rel(store, reader, "Implements")
@enduml
