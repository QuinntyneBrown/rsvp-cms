@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Preview the page as a guest

Container_Boundary(admin, "Organiser app") {
  Component(preview, "PagePreviewPanel", "React 19 component", "Shows the draft preview at every viewport width; preview mode of Composer in src/admin/pages/PageComposer.tsx")
}
Container_Boundary(shared, "Shared page renderer") {
  Component(renderer, "PageBlockRenderer", "React 19 component", "Renders each block type; BlockView in src/shared/ui/blocks.tsx")
  Component(model, "PageRenderModel", "Shared type", "Ordered, display-ready blocks for one page")
}
Container_Boundary(api, "API application") {
  Component(ctrl, "PagePreviewController", "Express 5 route", "GET /api/events/:id/page/preview in src/api/events/routes.ts")
  Component(builder, "PageRenderModelBuilder", "Domain service", "Builds a render model from a page source")
  Component(draft, "PageDraft", "Domain aggregate", "Holds the unpublished blocks")
  ComponentDb(drafts, "PageDraftRepository", "Store interface; PrismaStore on PostgreSQL 17", "pages.draft (jsonb); Store.getPage")
}
Container_Boundary(rsvp, "Guest RSVP app") {
  Component(guestPage, "GuestPageView", "React 19 component", "Renders the published page; InvitePage in src/rsvp/InvitePage.tsx")
}
ComponentDb(published, "PublishedPageRepository", "Store interface; PrismaStore on PostgreSQL 17", "pages.published (jsonb); Store.getPage")

Rel(preview, ctrl, "Requests the draft render model from", "JSON/HTTPS")
Rel(ctrl, builder, "Requests a render model from")
Rel(builder, draft, "Reads blocks from")
Rel(ctrl, drafts, "Loads the draft through")
Rel(builder, model, "Produces")
Rel(preview, renderer, "Renders the model with")
Rel(guestPage, renderer, "Renders the model with")
Rel(guestPage, published, "Reads the published page through GET /api/public/invite/:token from", "JSON/HTTPS")
@enduml
