@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Containers — Preview the page as a guest

Person(organiser, "Organiser", "Previews the page draft")
Person_Ext(guest, "Guest", "Reads the published page")
System_Boundary(cms, "RSVP CMS") {
  Container(admin, "Organiser app", "React 19, Vite", "Preview panel under src/admin")
  Container(rsvp, "Guest RSVP app", "React 19, Vite", "Public page under src/rsvp")
  Container(shared, "Shared page renderer", "React 19 module", "Block renderers and block specs in src/shared/ui/blocks.tsx")
  Container(api, "API application", "Node.js 24, Express 5", "Preview endpoint under src/api/events and public invitation endpoint under src/api/public")
  ContainerDb(db, "Application database", "PostgreSQL 17", "Stores page drafts and published pages in the pages table")
}

Rel(organiser, admin, "Opens the preview using", "HTTPS")
Rel(admin, api, "Loads the draft from", "JSON/HTTPS")
Rel(api, db, "Reads the draft and the published page from", "Prisma ORM 7, @prisma/adapter-pg")
Rel(admin, shared, "Renders the draft with")
Rel(guest, rsvp, "Reads the page from", "HTTPS")
Rel(rsvp, shared, "Renders the published page with")
Rel(rsvp, api, "Reads the published page from", "JSON/HTTPS")
@enduml
