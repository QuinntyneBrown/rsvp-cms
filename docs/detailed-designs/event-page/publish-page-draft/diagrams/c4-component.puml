@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Save, publish and discard page drafts

Container_Boundary(admin, "Organiser app") {
  Component(status, "DraftStatusBar", "React 19 component", "Shows the Draft saved and Published status texts; status line of Composer in src/admin/pages/PageComposer.tsx")
  Component(autosave, "DraftAutosave", "React 19 effect", "Saves the draft 2 seconds after the last keystroke; inside Composer")
  Component(guard, "UnsavedChangesGuard", "React 19 effect", "Warns before the organiser leaves with unpublished changes; beforeunload listener in Composer")
  Component(discard, "DiscardChangesDialog", "React 19 component", "Asks the organiser to confirm the discard; shared Dialog used by Composer")
}
Container_Boundary(api, "API application") {
  Component(ctrl, "PageDraftController", "Express 5 routes", "PUT /page/draft, POST /page/publish and POST /page/discard under /api/events/:id in src/api/events/routes.ts")
  Component(publisher, "PagePublisher", "Domain service", "Copies a valid draft to the published page and resets the draft")
  Component(draft, "PageDraft", "Domain aggregate", "Holds the unpublished blocks")
  ComponentDb(drafts, "PageDraftRepository", "Store interface; PrismaStore on PostgreSQL 17", "pages.draft (jsonb); Store.saveDraft and Store.discardDraft")
  ComponentDb(published, "PublishedPageRepository", "Store interface; PrismaStore on PostgreSQL 17", "pages.published (jsonb) and events.status; Store.publishDraft")
}
Container(rsvp, "Guest RSVP app", "React 19, Vite", "Serves the public page under src/rsvp")

Rel(status, ctrl, "Reads draft state from", "JSON/HTTPS")
Rel(autosave, ctrl, "Saves the draft through", "JSON/HTTPS")
Rel(discard, ctrl, "Requests the discard from", "JSON/HTTPS")
Rel(ctrl, publisher, "Requests publish or discard from")
Rel(publisher, draft, "Validates and resets")
Rel(ctrl, drafts, "Saves the draft through")
Rel(publisher, published, "Writes the published page through")
Rel(rsvp, published, "Reads the published page through GET /api/public/invite/:token from", "JSON/HTTPS")
@enduml
