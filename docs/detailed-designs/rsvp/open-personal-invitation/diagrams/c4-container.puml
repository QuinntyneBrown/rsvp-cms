@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Containers — Open a personal invitation link

Person(guest, "Guest", "Invitee with a personal link")
System_Boundary(invitely, "Invitely") {
  Container(rsvp, "Guest RSVP application", "React 19, Vite", "Public invitation page under src/rsvp")
  Container(publicApi, "Public API application", "Node.js 24, Express 5", "Unauthenticated endpoints under src/api/public")
  ContainerDb(db, "Invitely database", "PostgreSQL 17", "Events, guests with their personal-link tokens, published pages and replies")
}
Rel(guest, rsvp, "Opens the personal link in", "HTTPS")
Rel(rsvp, publicApi, "Requests the invitation for the token from", "JSON/HTTPS")
Rel(publicApi, db, "Reads links, events and published content from", "Prisma ORM 7, @prisma/adapter-pg")
@enduml
