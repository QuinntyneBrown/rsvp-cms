@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Containers — Submit an RSVP

Person(guest, "Guest", "Invitee with a personal link or invitation code")
System_Boundary(invitely, "Invitely") {
  Container(rsvp, "Guest RSVP application", "React 19, Vite", "Public RSVP form under src/rsvp")
  Container(publicApi, "Public API application", "Node.js 24, Express 5", "RSVP endpoint under src/api/public")
  ContainerDb(db, "Invitely database", "PostgreSQL 17", "Replies (responses table), guests and events")
}
Rel(guest, rsvp, "Fills in and sends the RSVP in", "HTTPS")
Rel(rsvp, publicApi, "Posts the reply to", "JSON/HTTPS")
Rel(publicApi, db, "Reads the invitation and writes the reply to", "Prisma ORM 7, @prisma/adapter-pg")
@enduml
