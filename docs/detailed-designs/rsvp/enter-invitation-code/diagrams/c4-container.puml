@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Containers — Enter an invitation code

Person(guest, "Guest", "Invitee with an invitation code")
System_Boundary(invitely, "Invitely") {
  Container(rsvp, "Guest RSVP application", "React 19, Vite", "Public RSVP page under src/rsvp")
  Container(publicApi, "Public API application", "Node.js 24, Express 5", "Unauthenticated endpoints under src/api/public")
  ContainerDb(db, "Invitely database", "PostgreSQL 17", "Events and guests with their invitation codes under src/data")
}
Rel(guest, rsvp, "Uses", "HTTPS")
Rel(rsvp, publicApi, "Submits the invitation code to", "JSON/HTTPS")
Rel(publicApi, db, "Reads invitation records from", "Prisma ORM 7, @prisma/adapter-pg")
@enduml
