title Class structure — Enter an invitation code

enum InvitationCodeResult {
  Accepted
  Rejected
}

class InvitationCode {
  +string Value
  +{static} Normalise(raw: string): string
}

class InvitationRecord {
  +UUID GuestId
  +UUID EventId
  +bool IsActive
}

class InvitationCodeService {
  +Redeem(rawCode: string, now: DateTime): InvitationCodeResult
}

interface InvitationCodeRepository {
  +FindByCode(code: InvitationCode): InvitationRecord
}

class InvitationCodeController {
  +Post(rawCode: string): HttpResult
}

InvitationCodeController --> InvitationCodeService : redeems with
InvitationCodeService --> InvitationCode : normalises
InvitationCodeService --> InvitationCodeRepository : looks up with
InvitationCodeService ..> InvitationCodeResult : returns
InvitationCodeRepository ..> InvitationRecord : returns
@enduml
